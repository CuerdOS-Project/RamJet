[Unit]
Description=ramjet - process priority daemon
Documentation=https://github.com/CuerdOS-Project/RamJet
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ramjet
Restart=on-failure
RestartSec=5

# Security hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/sys/fs/cgroup
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ramjet
LimitNICE=true

[Install]
WantedBy=multi-user.target
